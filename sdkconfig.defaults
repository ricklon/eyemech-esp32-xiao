# Shared baseline. Anything changed via `pio run -t menuconfig` lands in the
# generated sdkconfig (gitignored) — promote keepers here.

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Grove Vision AI runs at 921600 baud and overruns a default-sized RX buffer
# mid-packet, which silently corrupts box parsing. Same failure the MicroPython
# port hit before rxbuf was raised to 2048.
CONFIG_UART_ISR_IN_IRAM=y

# HTTP control page + JSON endpoints
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Both XIAO variants ship 4MB flash; the IDF default of 2MB triggers a
# size-mismatch warning and wastes half the part.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# App partition sizing lives in partitions.csv, wired up via
# board_build.partitions so PlatformIO's size check agrees with the real table.
